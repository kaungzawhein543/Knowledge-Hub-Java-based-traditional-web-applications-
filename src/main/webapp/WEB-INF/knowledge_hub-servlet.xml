<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xmlns:context="http://www.springframework.org/schema/context"
       xmlns:mvc="http://www.springframework.org/schema/mvc"
       xsi:schemaLocation="http://www.springframework.org/schema/beans 
                           http://www.springframework.org/schema/beans/spring-beans.xsd
                           http://www.springframework.org/schema/context 
                           http://www.springframework.org/schema/context/spring-context.xsd 
                           http://www.springframework.org/schema/mvc 
                           http://www.springframework.org/schema/mvc/spring-mvc.xsd">

    <mvc:annotation-driven/>
    
	<mvc:resources mapping="/resources/**" location="/resources/" />
    <context:component-scan base-package="knowledge_hub.controllers"/>
    <bean id="emailService" class="services.EmailService"/>
    <bean class="org.springframework.web.servlet.view.InternalResourceViewResolver">
    	<property name="prefix" value="/WEB-INF/views/"/>
    	<property name="suffix" value=".jsp"/>
    </bean>
 	<bean id="rm" class="knowledge_hub.utils.ResultMessage"/>
    <bean id="user_repo" class="knowledge_hub.persistant.UserRepository"></bean>
    <bean id="blog_repo" class="knowledge_hub.persistant.BlogRepository"></bean>
    <bean id="bloggerUser_repo" class="knowledge_hub.persistant.Blogger_userRepository"></bean>
    <bean id="feedback_repo" class="knowledge_hub.persistant.OtherRepository"></bean>
    <bean id="multipartResolver" class="org.springframework.web.multipart.commons.CommonsMultipartResolver">
	    <property name="maxUploadSize" value="16777216"/>
	</bean>
	
	<bean id="mailSender" class="org.springframework.mail.javamail.JavaMailSenderImpl">
    <property name="host" value="smtp.gmail.com" />
    <property name="port" value="587" />
    <property name="username" value="knowledgehub432@gmail.com" />
    <property name="password" value="rasz egnj gdqn rreu" /> <!-- Update this line with your actual Gmail password -->
    <property name="javaMailProperties">
        <props>
            <prop key="mail.smtp.auth">true</prop>
            <prop key="mail.smtp.starttls.enable">true</prop>
        </props>
    </property>
</bean>

	
</beans>
